# copy to .env (".env.*" is gitignored, hence this filename)
LINQ_API_KEY=            # bearer token, in hand
LINQ_FROM_NUMBER=        # provisioned +1 number
LINQ_WEBHOOK_SECRET=     # whsec_... printed by `node subscribe.js`
PUBLIC_URL=              # cloudflared tunnel URL, set after tunnel is up
AGENT_URL=http://localhost:4001/handle
PORT=4000
